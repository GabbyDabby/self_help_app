<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="self_help_rpg.DailyCheckInPopup"
             Title="DailyCheckInPopup"
             BackgroundColor="Purple">
    <VerticalStackLayout>
        <Label
            Text="Daily Streak"
            FontSize="40"
            FontFamily="ArchivoBlack-Regular"
            TextColor="Orange"
            HorizontalOptions="Center"
            Padding="0, 100, 0, 0">
            
        </Label>
        <HorizontalStackLayout
            HorizontalOptions="Center"
            Padding="0, 150, 0, 0"
            Spacing="20">
            <Image
                Source="goldstarcoin.png"
                WidthRequest="50">
            </Image>
            <Image
                Source="goldstarcoin.png"
                WidthRequest="50">
            </Image>
            <Image
                Source="goldstarcoin.png"
                WidthRequest="50">
            </Image>
            <Image
                Source="goldstarcoin.png"
                WidthRequest="50">
            </Image>
            <Image
                Source="goldstarcoin.png"
                WidthRequest="50">
            </Image>
        </HorizontalStackLayout>
        <Label
            x:Name="StreakCounter"
            Text="24"
            FontSize="60"
            TextColor="Orange"
            FontFamily="ArchivoBlack-Regular"
            HorizontalTextAlignment="Center"
            Padding="0, 100, 0, 0">

        </Label>
        <Label
            x:Name="DaysLabel"
            Text="DAYS!"
            FontSize="60"
            TextColor="Orange"
            FontFamily="ArchivoBlack-Regular"
            HorizontalTextAlignment="Center"
            Padding="0, 30, 0, 0">

        </Label>
        <Label
            x:Name="CheerLabel"
            Text=""
            FontSize="40"
            TextColor="Pink"
            FontFamily="ArchivoBlack-Regular"
            HorizontalTextAlignment="Center"
            Padding="0, 30, 0, 0">

        </Label>
    </VerticalStackLayout>
</ContentPage>